# Home Assistant connection used by ha-device-mcp
HA_URL=http://YOUR_HOME_ASSISTANT_HOST:8123
HA_LONG_LIVED_ACCESS_TOKEN=replace-with-ha-token
HA_TIMEOUT_SECONDS=10
HA_VERIFY_SSL=true
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_AUTH_TOKEN=replace-with-a-separate-strong-token
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Cloudflare Tunnel token from the Cloudflare dashboard or `cloudflared tunnel token NAME`.
# Keep secret; do not commit a real token.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
