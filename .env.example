# Copy to .env next to docker-compose.yml, then `chmod 600 .env`. Never commit .env.
# Every variable below is read by the named service (see that repo's config code);
# nothing here is passed to a service that does not use it.

# ---- ha-mcp (../ha-device-mcp, src/ha_device_mcp/config.py) --------------------
# Home Assistant base URL. Use http://host.docker.internal:8123 if HA runs on this Pi.
HA_URL=http://YOUR_HOME_ASSISTANT_HOST:8123
# HA Profile -> Security -> Long-lived access tokens (prefer a dedicated non-admin user)
HA_LONG_LIVED_ACCESS_TOKEN=replace-with-ha-token
HA_TIMEOUT_SECONDS=10
HA_VERIFY_SSL=true
# Optional explicit entity IDs; leave blank to auto-discover via HA integrations.
OASIS_LIGHT_ENTITY_ID=
PURA_NIGHTLIGHT_ENTITY_ID=
PURA_FRAGRANCE_SELECT_ENTITY_ID=
PURA_INTENSITY_SELECT_ENTITY_ID=
HATCH_LIGHT_ENTITY_ID=
HATCH_MEDIA_PLAYER_ENTITY_ID=
HATCH_POWER_SWITCH_ENTITY_ID=
# MCP transport settings (MCP_HOST/MCP_PORT are fixed to 0.0.0.0/8000 in Compose)
MCP_PATH=/mcp
# Bearer token Poke sends as "Authorization: Bearer ..."   (openssl rand -hex 32)
MCP_AUTH_TOKEN=replace-with-a-separate-strong-token
# Exact Host headers the server accepts; include the public tunnel hostname.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,ha.yourdomain.com
LOG_LEVEL=INFO

# ---- flaim-mcp (../flaim/nfl-metrics, nfl_metrics/config.py) -------------------
# Bearer token for /sse + /messages (or /mcp). >= 24 chars.   (openssl rand -hex 32)
NFL_MCP_TOKEN=replace-with-nfl-mcp-token
# sse (default; endpoint /sse) or streamable-http (endpoint /mcp)
NFL_MCP_TRANSPORT=sse
# Hours before the current season's raw nflverse files are re-downloaded
NFL_RAW_TTL_HOURS=12
# Hours before cached aggregates for the current season are recomputed
NFL_DERIVED_TTL_HOURS=6
# Seasons held in memory; keep at 1 on a Pi
NFL_MAX_SEASONS_IN_MEMORY=1
# Polars worker threads (Pi 5 has 4 cores)
POLARS_MAX_THREADS=3
# Container memory limit
NFL_MEM_LIMIT=1536m
# NOTE: the flaim Node gateway (FLAIM_MCP_TOKEN, ESPN_SWID, ESPN_S2, leagues.json)
# is not part of this stack. Add it from ../flaim/docker-compose.yml if needed.

# ---- citibike-mcp (../citibike-lookup) ------------------------------------------
# The repo currently has no code or .env.example; variables will be added once it
# defines them. Reserved host port 8002.

# ---- cloudflared ----------------------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> your tunnel -> connector token. Keep secret.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
