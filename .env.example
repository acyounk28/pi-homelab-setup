# Home Assistant runs with network_mode: host, so ha-mcp reaches it through the
# Docker host gateway (extra_hosts in docker-compose.yml). Change only if HA runs
# elsewhere.
HA_URL=http://host.docker.internal:8123
# Image/tag for the homeassistant service. Pin HA_VERSION (e.g. 2025.9.4) for
# reproducible deploys; ghcr.io mirrors Docker Hub without pull rate limits.
HA_IMAGE=ghcr.io/home-assistant/home-assistant
HA_VERSION=stable
# Where Home Assistant stores its state (configuration.yaml, .storage, database,
# custom_components). Relative to this directory; git-ignored. Absolute paths also work.
# scripts/install-homeassistant.sh seeds it from homeassistant/configuration.yaml and
# stages HACS + the components in homeassistant/custom_components.txt.
HA_CONFIG_DIR=./config/homeassistant
# Docker bridge CIDR(s) HA should trust as reverse proxies (cloudflared / ha-mcp
# arrive from the pi-homelab bridge). Written into configuration.yaml by the installer.
HA_TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
# Create this after initial Home Assistant onboarding with scripts/ha_token.py
# (or Profile -> Security -> Long-lived access tokens); see ENV_GUIDE.md.
HA_LONG_LIVED_ACCESS_TOKEN=replace-with-ha-token
HA_TIMEOUT_SECONDS=10
HA_VERIFY_SSL=true
TZ=America/New_York
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_AUTH_TOKEN=replace-with-a-separate-strong-token
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,ha-mcp.yourdomain.com

# Explicit entity IDs for ha-device-mcp. Generate them with
#   scripts/export_entities.py --merge-into .env
# (docs/ha-device-mcp.md) rather than typing them; omitted Pura/Hatch IDs are
# auto-discovered by the bridge. OASIS_LIGHT_ENTITY_ID must ALWAYS be set for
# Oasis Lighting (heyoasis.com): the bridge's own discovery targets the unrelated
# Oasis Mini sand table integration (docs/devices/oasis-lighting.md).
# OASIS_LIGHT_ENTITY_ID=light.living_room
# PURA_NIGHTLIGHT_ENTITY_ID=light.pura_nightlight
# PURA_FRAGRANCE_SELECT_ENTITY_ID=select.pura_fragrance
# PURA_INTENSITY_SELECT_ENTITY_ID=select.pura_intensity
# HATCH_LIGHT_ENTITY_ID=light.hatch_restore_light
# HATCH_MEDIA_PLAYER_ENTITY_ID=media_player.hatch_restore_media_player
# HATCH_POWER_SWITCH_ENTITY_ID=switch.hatch_restore_power_switch
# Windmill AC: no auto-discovery; the fan tools are only registered when this is set
# (docs/devices/windmill.md).
# WINDMILL_FAN_ENTITY_ID=fan.windmill_ac

# Flaim MCP / ESPN and Sleeper leagues.
# Flaim reads these directly; no config/leagues.json is needed. If ESPN_S2/SWID are
# missing or placeholders, Flaim starts anyway with ESPN disabled and Sleeper working.
# League IDs may carry a team id: 123456:7 (ESPN teamId) or 12000...:3 (Sleeper rosterId).
ESPN_S2=replace-with-espn-s2-cookie
SWID=replace-with-swid-cookie
ESPN_LEAGUE_IDS=replace-with-comma-separated-league-ids
SLEEPER_LEAGUE_IDS=replace-with-comma-separated-league-ids
# Bearer token for https://flaim.yourdomain.com/mcp; at least 24 characters.
# (FLAIM_MCP_AUTH_TOKEN is still accepted as a legacy name.)
FLAIM_MCP_TOKEN=replace-with-a-separate-strong-token
# The container always listens on 8790 (Cloudflare origin http://flaim-mcp:8790).
FLAIM_MCP_HOST=0.0.0.0
FLAIM_MCP_PORT=8790

# Citi Bike MCP (citibike-lookup, src/citibike_lookup/config.py). Container listens
# on 8002 at /mcp; readiness /readyz (503 until the GBFS feeds are loaded).
# The container itself reads MCP_PATH / MCP_AUTH_TOKEN / MCP_ALLOWED_HOSTS (same
# names as ha-mcp), so Compose maps CITIBIKE_MCP_* -> MCP_* to keep tokens separate;
# MCP_HOST/MCP_PORT are pinned to 0.0.0.0/8002 in docker-compose.yml.
# If CITIBIKE_MCP_TOKEN is unset the service reuses MCP_AUTH_TOKEN.
CITIBIKE_MCP_TOKEN=replace-with-a-separate-strong-token
#CITIBIKE_MCP_PATH=/mcp
# Optional Host allowlist; include the public hostname, e.g. bike.yourdomain.com.
#CITIBIKE_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,bike.yourdomain.com
#CITIBIKE_LOG_LEVEL=INFO
# GBFS auto-discovery file; feed URLs are read from it (defaults = public Citi Bike feeds)
#GBFS_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
#GBFS_LANGUAGE=en
#GBFS_TIMEOUT_SECONDS=10
# station_status poll interval (min 10; feed ttl wins if larger)
#GBFS_STATUS_POLL_SECONDS=60
# station_information / vehicle_types / system_information refresh (min 60)
#GBFS_INFORMATION_POLL_SECONDS=3600
# consecutive failed polls before /readyz (and the healthcheck) go unhealthy
#GBFS_MAX_STALE_POLLS=5

# Cloudflare Tunnel token. Keep all real credentials private; never commit .env.
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
