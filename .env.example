# Match the variable names used by acyounk28/ha-device-mcp.
# From the container, host.docker.internal resolves to the Pi host.
HA_URL=http://YOUR_HOME_ASSISTANT_HOST:8123
HA_LONG_LIVED_ACCESS_TOKEN=replace-with-ha-token
HA_TIMEOUT_SECONDS=10
HA_VERIFY_SSL=true
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# Generate a separate strong secret for MCP bearer authentication.
MCP_AUTH_TOKEN=replace-with-a-separate-strong-token
# Add the public hostname used by the tunnel, as appropriate for Host validation.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
